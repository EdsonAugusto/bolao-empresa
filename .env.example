# ---------------------------------------------------------------------------
# Uso CASEIRO, em rede local. Copie para .env antes do primeiro `up`.
#
# Para servidor com domínio e HTTPS não use este arquivo: rode `./instalar.sh`,
# que gera um .env de produção com segredos aleatórios e recusa subir com os
# valores de exemplo abaixo.
#
# NUNCA commite o .env.
# ---------------------------------------------------------------------------

# Ambiente ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Postgres ------------------------------------------------------------------
POSTGRES_USER=bolao
POSTGRES_PASSWORD=bolao_dev_password
POSTGRES_DB=bolao
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Porta exposta no host (evita conflito com um Postgres local na 5432)
POSTGRES_HOST_PORT=5433

# Redis ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6380

# API -----------------------------------------------------------------------
API_PORT=8000
# Chave de assinatura de JWT e de links de convite. Gere a sua:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Em ENVIRONMENT=production a aplicação RECUSA subir com este valor.
SECRET_KEY=troque-esta-chave-em-producao-ela-e-so-para-dev
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Aceitar qualquer Origin de faixa privada. É o que permite abrir a plataforma
# pelo IP do host no celular de quem chegou, sem reconfigurar a cada Wi-Fi.
# Em produção é desligado sozinho: `Origin` é escolhido por quem chama e, na
# internet aberta, não prova nada.
ALLOW_PRIVATE_NETWORK_ORIGINS=true

# Quem pode criar conta:
#   aberto  — qualquer pessoa. Padrão em rede local: estar na rede já é o convite.
#   convite — exige o código de 8 letras de um bolão. Padrão em servidor público.
#   fechado — ninguém; contas nascem por `python -m app.cli criar-admin`.
REGISTRATION_MODE=aberto

# Tentativas de login antes de barrar, por conta e por IP, na janela.
LOGIN_MAX_POR_CONTA=10
LOGIN_MAX_POR_IP=30
LOGIN_JANELA_SEGUNDOS=900

# Frontend ------------------------------------------------------------------
WEB_PORT=3000
NUXT_PUBLIC_API_BASE=/api

# nginx ---------------------------------------------------------------------
NGINX_HOST_PORT=8080

# Provedor de dados esportivos ----------------------------------------------
# manual            → você cadastra os jogos (ou cola um CSV). Custo zero,
#                     funciona offline, não depende de ninguém. É o padrão.
# globo             → coleta a tabela real do site do GE. Custo zero e traz
#                     datas, placares e escudos oficiais. NÃO é API pública:
#                     os termos do Globo não autorizam coleta automatizada e o
#                     endpoint interno muda sem aviso.
# football_data_org → chave grátis, mas a Série A brasileira está FORA do plano
#                     gratuito — só nos pagos.
# api_football      → cobre Brasileirão, estaduais e Copinha. Free de 100 req/dia.
FOOTBALL_PROVIDER=manual

FOOTBALL_DATA_ORG_KEY=
FOOTBALL_DATA_ORG_RATE_LIMIT_PER_MINUTE=10

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_RATE_LIMIT_PER_MINUTE=10
API_FOOTBALL_DAILY_QUOTA=100

# Notificações --------------------------------------------------------------
# Canais ativos, separados por vírgula: in_app | telegram | log
# in_app não depende de nada externo e é o padrão.
NOTIFICATION_CHANNELS=in_app
# Opcional: crie um bot com o @BotFather e cole o token aqui.
TELEGRAM_BOT_TOKEN=
